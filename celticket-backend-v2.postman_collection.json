{
  "info": {
    "name": "Celticket Backend API v2 (Sesion firmada)",
    "_postman_id": "dcba7e14-c40f-45fe-88d6-f44ea91961cd",
    "description": "Coleccion fase 3: autenticacion HTTP solo por Bearer token (sesion invitada firmada).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/guest-session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.token) {",
                  "  pm.collectionVariables.set('jwtToken', body.token);",
                  "}",
                  "if (body && body.sessionId) {",
                  "  pm.collectionVariables.set('sessionId', body.sessionId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{sessionId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/guest-session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "guest-session"
              ]
            },
            "description": "Emite token firmado para sesion de invitado."
          }
        }
      ]
    },
