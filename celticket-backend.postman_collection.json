  "item": [
    {
      "name": "Events",
      "item": [
        {
          "name": "GET /api/events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events"
              ]
            },
            "description": "Lista todos los eventos."
          }
        },
        {
          "name": "GET /api/events/{id}",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "{{eventId}}"
              ]
            },
            "description": "Obtiene un evento por ID."
          }
        },
        {
          "name": "GET /api/events/{id}/seats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventId}}/seats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "{{eventId}}",
                "seats"
              ]
            },
            "description": "Lista asientos del evento."
          }
        },
        {
          "name": "PUT /api/events/{id}/layout",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"meta\": {\n    \"seatSize\": 12,\n    \"seatGap\": 4\n  },\n  \"sections\": [\n    {\n      \"name\": \"PLATEA\",\n      \"rows\": 4,\n      \"cols\": 6,\n      \"basePriceCents\": 40000,\n      \"x\": 40,\n      \"y\": 110\n    },\n    {\n      \"name\": \"GENERAL\",\n      \"rows\": 5,\n      \"cols\": 8,\n      \"basePriceCents\": 20000,\n      \"x\": 350,\n      \"y\": 110\n    }\n  ],\n  \"tarimas\": [\n    {\n      \"name\": \"ESCENARIO\",\n      \"width\": 260,\n      \"height\": 40,\n      \"x\": 220,\n      \"y\": 30,\n      \"rotation\": 0,\n      \"enabled\": true\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/{{eventId}}/layout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "events",
                "{{eventId}}",
                "layout"
              ]
            },
            "description": "Actualiza layout del evento (ruta protegida)."
          }
        }
      ]
    },
    {
      "name": "Checkout",
      "item": [
        {
          "name": "POST /api/checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": {{eventId}},\n  \"seatIds\": [\"PLATEA-A1\", \"PLATEA-A2\"],\n  \"sessionId\": \"{{sessionId}}\",\n  \"buyerEmail\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/checkout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checkout"
              ]
            },
            "description": "Confirma compra directa de asientos bloqueados."
          }
        }
      ]
    },
