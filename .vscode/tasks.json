{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Infra: levantar MySQL y Redis",
            "type": "shell",
            "command": "docker compose up -d mysql redis",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Backend: ejecutar con Maven",
            "type": "shell",
            "command": "mvn spring-boot:run",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "problemMatcher": []
        }
    ]
}
